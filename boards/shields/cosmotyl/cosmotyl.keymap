#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/mouse.h>
#include <dt-bindings/zmk/outputs.h>
#include <behaviors/mouse_keys.dtsi>
#include <dt-bindings/zmk/ext_power.h>

#include "behaviors.dtsi"
/ {
    // Define a default keymap here.
    // See https://zmk.dev/docs/development/hardware-integration/new-shield#default-keymap.
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
// ╭───────────────┬────────────────┬────────────────┬─────────────────┬─────────────────┬──────────╮  ╭──────────┬──────────────────┬────────────────────┬─────────────────┬────────────────────────┬─────────────╮
                                     &kp W            &kp F             &kp P             &kp B         &kp J      &kp L              &kp U                &kp Y
// ├───────────────┼────────────────┼────────────────┼─────────────────┼─────────────────┼──────────┤  ├──────────┼──────────────────┼────────────────────┼─────────────────┼────────────────────────┼─────────────┤
     &studio_unlock &kp Q            &ht_left LALT R  &ht_left LSHFT S  &ht_left LCTRL T  &kp G         &kp M      &ht_right RCTRL N  &ht_right RSHFT E    &ht_right LALT I  &kp APO                  &td_layers
// ├───────────────┼────────────────┼────────────────┼─────────────────┼─────────────────┼──────────┤  ├──────────┼──────────────────┼────────────────────┼─────────────────┼────────────────────────┼─────────────┤
     &kp LCTRL      &ht_left LCMD A  &kp X            &kp C             &kp D             &kp V         &kp K      &kp H              &mm_cm_sc            &mm_pr_col        &ht_right RCMD O         &kp DEL
// ├───────────────┼────────────────┼────────────────┼─────────────────┼─────────────────┼──────────┤  ├──────────┼──────────────────┼────────────────────┴─────────────────┼────────────────────────┼─────────────┤
     &kp LSHFT      &kp Z                                                                                                                                                    &mm_qm_ex                &to 0
// ╰───────────────┴────────────────┴────────────────┼─────────────────┼─────────────────┼──────────┤  ├──────────┼──────────────────┼────────────────────┴─────────────────┴────────────────────────┴─────────────╯
                                                      &td_esc_scrl      &kp SPACE         &td_bs        &kp ENTER  &td_space_nav
                                                  // ╰─────────────────┴─────────────────┴──────────╯  ╰──────────┴──────────────────╯
            >;
        };
        NUM {
            bindings = <
// ╭───────────────┬────────────────┬────────────────┬─────────────────┬─────────────────┬────────────╮  ╭────────────┬──────────────────┬────────────────────┬─────────────────┬────────────────────────┬─────────────╮
                                     &none            &none             &none             &none           &kp PLUS     &mm_f7             &mm_f8               &mm_f9       
// ├───────────────┼────────────────┼────────────────┼─────────────────┼─────────────────┼────────────┤  ├────────────┼──────────────────┼────────────────────┼─────────────────┼────────────────────────┼─────────────┤
     &none          &none            &none            &none             &kp BACKSPACE     &kp LSHIFT      &kp KP_MINUS &mm_f4             &mm_f5               &mm_f6            &mm_f12                  &none
// ├───────────────┼────────────────┼────────────────┼─────────────────┼─────────────────┼────────────┤  ├────────────┼──────────────────┼────────────────────┼─────────────────┼────────────────────────┼─────────────┤
     &trans         &none            &none            &none            &none             &none            &kp EQUAL    &mm_f1             &mm_f2               &mm_f3            &mm_f11                  &none
// ├───────────────┼────────────────┼────────────────┼─────────────────┼─────────────────┼────────────┤  ├────────────┼──────────────────┼────────────────────┴─────────────────┼────────────────────────┼─────────────┤
     &none          &none                                                                                                                                                        &mm_f10                  &to 0
// ╰───────────────┴────────────────┴────────────────┼─────────────────┼─────────────────┼────────────┤  ├────────────┼──────────────────┼────────────────────┴─────────────────┴────────────────────────┴─────────────╯
                                                      &none             &none             &trans          &kp N0       &kp SPACE
                                                  // ╰─────────────────┴─────────────────┴────────────╯  ╰────────────┴──────────────────╯
            >;
        };
        NAV {
            display-name = "Nav";
            bindings = <
// ╭───────────────┬────────────────┬────────────────┬─────────────────┬─────────────────┬────────────╮  ╭────────────┬──────────────────┬────────────────────┬─────────────────┬────────────────────────┬─────────────╮
                                     &msc MOVE_UP     &none             &msc MOVE_DOWN    &msc MOVE_RIGHT &none        &none              &none                &none       
// ├───────────────┼────────────────┼────────────────┼─────────────────┼─────────────────┼────────────┤  ├────────────┼──────────────────┼────────────────────┼─────────────────┼────────────────────────┼─────────────┤
    &none           &msc MOVE_LEFT   &kp LALT         &kp LSHFT         &kp BACKSPACE     &mkp MB5        &none        &kp LEFT_ARROW     &kp DOWN             &kp UP            &kp RIGHT_ARROW          &none
// ├───────────────┼────────────────┼────────────────┼─────────────────┼─────────────────┼────────────┤  ├────────────┼──────────────────┼────────────────────┼─────────────────┼────────────────────────┼─────────────┤
    &kp TAB         &mkp MB4         &mmv MOVE_DOWN   &mmv MOVE_UP      &mmv MOVE_RIGHT   &none           &none        &kp HOME           &kp PG_DN            &kp PG_UP         &kp END                  &none
// ├───────────────┼────────────────┼────────────────┼─────────────────┼─────────────────┼────────────┤  ├────────────┼──────────────────┼────────────────────┴─────────────────┼────────────────────────┼─────────────┤
    &none           &mmv MOVE_LEFT                                                                                                                                               &mm_f10                  &to 0
// ╰───────────────┴────────────────┴────────────────┼─────────────────┼─────────────────┼────────────┤  ├────────────┼──────────────────┼────────────────────┴─────────────────┴────────────────────────┴─────────────╯
                                                      &none             &none             &none           &none        &trans
                                                  // ╰─────────────────┴─────────────────┴────────────╯  ╰────────────┴──────────────────╯
            >;
        };
        SYM {
            display-name = "Sym";
            bindings = <
// ╭───────────────┬────────────────┬────────────────┬─────────────────┬─────────────────┬────────────╮  ╭────────────┬──────────────────┬────────────────────┬─────────────────┬────────────────────────┬─────────────╮
                                     &kp DLLR         &kp CARET         &none             &none           &kp AMPS     &kp PLUS           &kp LBKT             &kp RBKT       
// ├───────────────┼────────────────┼────────────────┼─────────────────┼─────────────────┼────────────┤  ├────────────┼──────────────────┼────────────────────┼─────────────────┼────────────────────────┼─────────────┤
    &none           &kp TILDE        &kp LT           &kp GT            &kp BACKSPACE     &mkp MB5        &kp GRAVE    &kp KP_MINUS       &kp LPAR             &kp RPAR          &kp PRCNT                &kp BSLH
// ├───────────────┼────────────────┼────────────────┼─────────────────┼─────────────────┼────────────┤  ├────────────┼──────────────────┼────────────────────┼─────────────────┼────────────────────────┼─────────────┤
    &kp TAB         &kp UNDER        &kp HASH         &none             &none             &none           &none        &kp EQUAL          &kp LBRC             &kp RBRC          &kp ASTRK                &kp PIPE
// ├───────────────┼────────────────┼────────────────┼─────────────────┼─────────────────┼────────────┤  ├────────────┼──────────────────┼────────────────────┴─────────────────┼────────────────────────┼─────────────┤
    &none           &none                                                                                                                                                        &kp AT                   &to 0
// ╰───────────────┴────────────────┴────────────────┼─────────────────┼─────────────────┼────────────┤  ├────────────┼──────────────────┼────────────────────┴─────────────────┴────────────────────────┴─────────────╯
                                                      &none             &trans            &trans           &trans      &trans
                                                  // ╰─────────────────┴─────────────────┴────────────╯  ╰────────────┴──────────────────╯
            >;
        };
        GAME {
            display-name = "Game";
            bindings = <
// ╭───────────────┬────────────────┬────────────────┬─────────────────┬─────────────────┬────────────╮  ╭────────────┬──────────────────┬────────────────────┬─────────────────┬────────────────────────┬─────────────╮
                                     &kp Q            &kp W             &kp E             &kp R           &none        &none              &none                &none
// ├───────────────┼────────────────┼────────────────┼─────────────────┼─────────────────┼────────────┤  ├────────────┼──────────────────┼────────────────────┼─────────────────┼────────────────────────┼─────────────┤
    &kp N1          &kp TAB          &kp A            &kp S             &kp D             &kp F           &none        &none              &none                &none             &none                    &none
// ├───────────────┼────────────────┼────────────────┼─────────────────┼─────────────────┼────────────┤  ├────────────┼──────────────────┼────────────────────┼─────────────────┼────────────────────────┼─────────────┤
    &kp N2          &kp LCTRL        &kp Y            &kp X             &kp C             &kp V           &none        &none              &none                &none             &none                    &none
// ├───────────────┼────────────────┼────────────────┼─────────────────┼─────────────────┼────────────┤  ├────────────┼──────────────────┼────────────────────┴─────────────────┼────────────────────────┼─────────────┤
    &kp N3          &kp LSHFT                                                                                                                                                    &none                    &to 0
// ╰───────────────┴────────────────┴────────────────┼─────────────────┼─────────────────┼────────────┤  ├────────────┼──────────────────┼────────────────────┴─────────────────┴────────────────────────┴─────────────╯
                                                      &none             &kp SPACE         &kp LEFT_ALT    &none        &none
                                                  // ╰─────────────────┴─────────────────┴────────────╯  ╰────────────┴──────────────────╯
            >;
        };

        EXTRAS {
            display-name = "Xtra";
            bindings = <
// ╭───────────────┬────────────────┬────────────────┬─────────────────┬─────────────────┬────────────────────╮  ╭────────────┬──────────────────┬────────────────────┬─────────────────┬────────────────────────┬─────────────╮
                                     &none            &none             &none             &kp C_BRIGHTNESS_INC    &bt BT_SEL 0 &bt BT_SEL 1       &bt BT_SEL 2         &bt BT_SEL 3
// ├───────────────┼────────────────┼────────────────┼─────────────────┼─────────────────┼────────────────────┤  ├────────────┼──────────────────┼────────────────────┼─────────────────┼────────────────────────┼─────────────┤
    &studio_unlock  &none            &kp A            &kp S             &kp D             &kp C_BRIGHTNESS_DEC    &none        &kp C_PREVIOUS     &kp C_PLAY_PAUSE     &kp C_STOP        &out OUT_TOG             &bt BT_CLR
// ├───────────────┼────────────────┼────────────────┼─────────────────┼─────────────────┼────────────────────┤  ├────────────┼──────────────────┼────────────────────┼─────────────────┼────────────────────────┼─────────────┤
    &kp C_SLEEP     &none            &kp C_AC_COPY    &kp C_AC_CUT      &kp C_AC_PASTE    &none                   &none        &kp K_MUTE         &kp C_VOLUME_DOWN    &kp C_VOLUME_UP   &kp C_NEXT               &none
// ├───────────────┼────────────────┼────────────────┼─────────────────┼─────────────────┼────────────────────┤  ├────────────┼──────────────────┼────────────────────┴─────────────────┼────────────────────────┼─────────────┤
    &kp C_AL_COFFEE &kp C_AC_UNDO                                                                                                                                                        &kp PRINTSCREEN          &to 0
// ╰───────────────┴────────────────┴────────────────┼─────────────────┼─────────────────┼────────────────────┤  ├────────────┼──────────────────┼────────────────────┴─────────────────┴────────────────────────┴─────────────╯
                                                      &none             &none             &none                   &none        &none
                                                  // ╰─────────────────┴─────────────────┴────────────────────╯  ╰────────────┴──────────────────╯
            >;
        };

        SLOW {
            display-name = "Slow";
            bindings = <
// ╭───────────────┬────────────────┬────────────────┬─────────────────┬─────────────────┬────────────╮  ╭────────────┬──────────────────┬────────────────────┬─────────────────┬────────────────────────┬─────────────╮
                                     &trans           &trans            &trans            &trans          &trans       &trans             &trans               &trans
// ├───────────────┼────────────────┼────────────────┼─────────────────┼─────────────────┼────────────┤  ├────────────┼──────────────────┼────────────────────┼─────────────────┼────────────────────────┼─────────────┤
    &trans          &trans           &trans           &trans            &trans            &trans          &trans       &trans             &trans               &trans            &trans                   &trans
// ├───────────────┼────────────────┼────────────────┼─────────────────┼─────────────────┼────────────┤  ├────────────┼──────────────────┼────────────────────┼─────────────────┼────────────────────────┼─────────────┤
    &trans          &trans           &trans           &trans            &trans            &trans          &trans       &trans             &trans               &trans            &trans                   &trans
// ├───────────────┼────────────────┼────────────────┼─────────────────┼─────────────────┼────────────┤  ├────────────┼──────────────────┼────────────────────┴─────────────────┼────────────────────────┼─────────────┤
    &trans          &trans                                                                                                                                                       &trans                   &to 0
// ╰───────────────┴────────────────┴────────────────┼─────────────────┼─────────────────┼────────────┤  ├────────────┼──────────────────┼────────────────────┴─────────────────┴────────────────────────┴─────────────╯
                                                      &trans            &trans            &trans          &trans       &trans
                                                  // ╰─────────────────┴─────────────────┴────────────╯  ╰────────────┴──────────────────╯
            >;
        };

        SCROLL {
            display-name = "Scroll";
            bindings = <
// ╭───────────────┬────────────────┬────────────────┬─────────────────┬─────────────────┬────────────╮  ╭────────────┬──────────────────┬────────────────────┬─────────────────┬────────────────────────┬─────────────╮
                                     &trans           &trans            &trans            &trans          &trans       &trans             &trans               &trans
// ├───────────────┼────────────────┼────────────────┼─────────────────┼─────────────────┼────────────┤  ├────────────┼──────────────────┼────────────────────┼─────────────────┼────────────────────────┼─────────────┤
    &trans          &trans           &trans           &trans            &trans            &trans          &trans       &trans             &trans               &trans            &trans                   &trans
// ├───────────────┼────────────────┼────────────────┼─────────────────┼─────────────────┼────────────┤  ├────────────┼──────────────────┼────────────────────┼─────────────────┼────────────────────────┼─────────────┤
    &trans          &trans           &trans           &trans            &trans            &trans          &trans       &trans             &trans               &trans            &trans                   &trans
// ├───────────────┼────────────────┼────────────────┼─────────────────┼─────────────────┼────────────┤  ├────────────┼──────────────────┼────────────────────┴─────────────────┼────────────────────────┼─────────────┤
    &trans          &trans                                                                                                                                                       &trans                   &to 0
// ╰───────────────┴────────────────┴────────────────┼─────────────────┼─────────────────┼────────────┤  ├────────────┼──────────────────┼────────────────────┴─────────────────┴────────────────────────┴─────────────╯
                                                      &trans            &trans            &trans          &trans       &trans
                                                  // ╰─────────────────┴─────────────────┴────────────╯  ╰────────────┴──────────────────╯
            >;
        };
    };
};
